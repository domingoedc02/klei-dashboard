{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Klei Bridal",
  "version": "0.1.0",
  "identifier": "co.klei.bridal",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Klei Bridal",
        "width": 1280,
        "height": 800,
        "minWidth": 1100,
        "minHeight": 700,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' klei-img: data:; connect-src 'none'; style-src 'self'; script-src 'self'; font-src 'self'",
      "devCsp": "default-src 'self'; img-src 'self' klei-img: data:; connect-src ws://localhost:1420 http://localhost:1420; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "klei"
        ]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/OWNER/RELEASES_REPO/releases/latest/download/latest.json"
      ],
      "pubkey": "REPLACE_WITH_UPDATER_PUBLIC_KEY",
      "requireSignedVersion": true
    }
  }
}
