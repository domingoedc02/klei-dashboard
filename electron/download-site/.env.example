# Download site (story 18.5). Copy to electron/download-site/.env locally; .env is git-ignored.
# In Dokploy, enter these under the application's Environment tab. Never commit a real value.
# An empty token stops the site at start-up (the message does not print the value).

# Container port. Keep 8090 unless the server already uses it.
KLEI_DOWNLOAD_PORT=8090

# Secret URL path: 43 or more characters from [A-Za-z0-9_-]. Generate on your own machine:
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
# Rotating it changes the URL compiled into every installed app (reinstall needed).
# May also be given as KLEI_DOWNLOAD_PATH_TOKEN_FILE (a mounted file).
KLEI_DOWNLOAD_PATH_TOKEN=

# Folder inside the container that holds <version>/release.json and the installers.
# Mount a Dokploy volume or host folder here, read-only. Do not change unless the mount changes.
KLEI_DOWNLOAD_DATA_DIR=/data

# --- NOT for Dokploy: GitHub environment `electron-release` (story 19.4) ---
# ELECTRON_DOWNLOAD_BASE_URL   https://<subdomain>/<token>   (secret, same token as above)
# ELECTRON_DEPLOY_HOST         server host name or IP        (secret)
# ELECTRON_DEPLOY_USER         SSH user, write access to the data folder only (secret)
# ELECTRON_DEPLOY_KEY          its private key               (secret)
# ELECTRON_DEPLOY_KNOWN_HOSTS  output of: ssh-keyscan <host> (secret)
# ELECTRON_DEPLOY_PATH         the host folder mounted at KLEI_DOWNLOAD_DATA_DIR (variable)
