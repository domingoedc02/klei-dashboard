{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "verbatimModuleSyntax": false,
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "rewriteRelativeImportExtensions": true,
    "lib": ["ES2023"],
    "rootDir": "src",
    "outDir": "build"
  },
  "include": ["src/main", "src/shared"]
}
