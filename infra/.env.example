# Copy to infra/.env and fill every empty value. infra/.env is git-ignored.
# Generate a full set of secrets:  infra/ci/gen-keys.sh > infra/.env   (then add the rest below)
# Secrets have no defaults: an empty value stops `docker compose` with the variable name.
# Any secret may also be given as <NAME>_FILE (a mounted file) in production.

# --- PostgreSQL (Story 1.1)
KLEI_DB_NAME=klei
KLEI_DB_USER=
KLEI_DB_PASSWORD=

# --- Object store (Story 1.1)
KLEI_S3_ACCESS_KEY=
KLEI_S3_SECRET_KEY=
KLEI_S3_BUCKET=klei-objects
# Percent of free disk kept as headroom (SeaweedFS -volume.minFreeSpace)
KLEI_S3_MIN_FREE_SPACE=5

# --- Keys (used from Story 1.2/1.3; generated by infra/ci/gen-keys.sh, 32 bytes base64 each)
# Keep an offline copy of all three apart from the backups. Losing every KEK loses all data.
KLEI_KEK_1=
# Rotation slots, filled one at a time (infra/ops/key-custody.md); blank means unused.
KLEI_KEK_2=
KLEI_KEK_3=
KLEI_KEK_4=
KLEI_KEK_ACTIVE=1
KLEI_BIDX_KEY=
# EdDSA private key, base64 PKCS8
KLEI_JWT_KEY=

# --- Backend (Story 1.2 onward)
KLEI_DB_URL=jdbc:postgresql://postgres:5432/klei
KLEI_S3_ENDPOINT=http://objectstore:8333
KLEI_API_BASE_URL=
KLEI_AUTH_BASE_URL=
KLEI_TRUSTED_PROXY_HOPS=1
# Allow an http:// AI Base URL; false except in dev
KLEI_AI_DEV_MODE=false

# --- Mail (Story 2.1 onward). Dev: Mailpit on mailpit:1025, no auth.
KLEI_SMTP_HOST=mailpit
KLEI_SMTP_PORT=1025
KLEI_SMTP_USER=
KLEI_SMTP_PASSWORD=
# From and Reply-To of every Reply. Required outside the dev and test profiles; the backend stops without it.
KLEI_MAIL_FROM=
# true outside dev: STARTTLS is then required and the relay certificate is checked
KLEI_SMTP_REQUIRE_TLS=false
KLEI_SMTP_AUTH=false

# --- First Admin (Story 1.4). Used only while no Admin exists. Remove both after the first start.
# Password: 8 to 128 characters with at least one digit. Both also accept a _FILE variant (path to a file).
KLEI_BOOTSTRAP_ADMIN_EMAIL=
KLEI_BOOTSTRAP_ADMIN_PASSWORD=

# Not here, ever: the AI Provider URL, key and models. They are entered in the AI settings screen.
